{
  "schemaVersion": 1,
  "id": "transfer-history-lookup",
  "name": "Transfer History Lookup",
  "description": "Read-only: count a member's transfers whose memo contains the given text, and read the first match's Reference, from the bank's transfer history page. Used to check whether a transfer was already committed (the fleet's verify).",
  "version": "1.2.0",
  "target": {
    "appId": "great-plains-cu-backoffice",
    "entryUrlPattern": "^http://localhost:4100/",
    "surfaceType": "web"
  },
  "inputs": [
    {
      "name": "username",
      "type": "string",
      "required": true,
      "description": "Value typed into \"User ID textbox\".",
      "redact": true
    },
    {
      "name": "password",
      "type": "string",
      "required": true,
      "description": "Value typed into \"Password textbox\".",
      "redact": true
    },
    {
      "name": "memberId",
      "type": "string",
      "required": true,
      "description": "Value typed into \"Member ID textbox\"; the member whose record is opened.",
      "redact": false
    },
    {
      "name": "memo",
      "type": "string",
      "required": true,
      "description": "Value typed into the history page's \"Memo textbox\" filter; matches memos that contain it.",
      "redact": false
    }
  ],
  "outputs": [
    {
      "name": "matchingCount",
      "type": "string",
      "shape": "Number of matching transfers as shown, e.g. \"1\"",
      "producedByStepId": "step-09"
    },
    {
      "name": "firstMatchRef",
      "type": "string",
      "shape": "Reference of the first matching transfer, e.g. \"TXN-000001\"; the grid's empty-state text (\"No matching transfers.\") when nothing matched",
      "producedByStepId": "step-10"
    }
  ],
