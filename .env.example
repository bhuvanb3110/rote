ANTHROPIC_API_KEY=
MOCK_APP_PORT=4100

# Fleet Postgres (docker-compose.yml). Local-only dev values; .env is never committed.
ROTE_PG_PASSWORD=rote_dev_only
ROTE_PG_PORT=55432
# App database (workers, API, `npm run db:migrate`). 127.0.0.1, not localhost: the port is bound
# to IPv4 loopback and Node may resolve localhost to ::1 first.
ROTE_DATABASE_URL=postgres://rote:rote_dev_only@127.0.0.1:55432/rote
# Test database (created on demand by the tests, never the dev `rote` database).
ROTE_TEST_DATABASE_URL=postgres://rote:rote_dev_only@127.0.0.1:55432/rote_test

# Fleet worker bank credentials, per tenant x per input the capabilities mark redact: true
# (ROTE_CRED_<TENANT>_<INPUT>, src/worker/credentials.ts). FAKE values for the mock bank; at least 4
# characters each (every value is redacted from stored errors and logs). Workers refuse to start if
# any is missing.
ROTE_CRED_TENANT_A_USERNAME=fleet-op-a
ROTE_CRED_TENANT_A_PASSWORD=fake-pass-a
ROTE_CRED_TENANT_B_USERNAME=fleet-op-b
ROTE_CRED_TENANT_B_PASSWORD=fake-pass-b
ROTE_CRED_TENANT_C_USERNAME=fleet-op-c
ROTE_CRED_TENANT_C_PASSWORD=fake-pass-c
# Number of worker containers (docker compose up -d --build).
ROTE_WORKERS=4
